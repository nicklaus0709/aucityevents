// =====================================================================
// Eventos Capioví - esquema (migrado de Supabase a Prisma)
// La base es el PostgreSQL provisto por Base44 (servicio compose).
// Las reglas que antes eran RLS ahora se aplican en el servidor:
// requireUser / requireEventAccess (src/lib/auth.ts) autorizan cada
// operación, y las lecturas públicas filtran por is_published.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Usuarios y roles (antes auth.users + profiles) ----------
model users {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password_hash String   @db.Text
  full_name     String?
  role          String   @default("user") // 'super_admin' | 'user'
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  memberships event_members[]
  redemptions bono_purchases[] @relation("redeemed_by")
}

// ---------- Eventos (cada evento = un sitio) ----------
model events {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique
  name          String
  tagline       String?
  description   String?
  history       String?
  location      String?
  start_date    DateTime? @db.Date
  end_date      DateTime? @db.Date
  hero_image    String?
  theme_color   String    @default("#c2410c")
  accent_color  String    @default("#166534")
  logo_url      String?
  phone         String?
  email         String?
  youtube_url   String?
  instagram_url String?
  facebook_url  String?
  whatsapp      String?
  bonos_enabled Boolean   @default(false)
  is_published  Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  members   event_members[]
  gallery   gallery_images[]
  schedule  schedule_items[]
  stalls    food_stalls[]
  ads       ads[]
  messages  contact_messages[]
  bonos     bono_types[]
  purchases bono_purchases[]
}

model event_members {
  event_id   String   @db.Uuid
  user_id    String   @db.Uuid
  role       String   @default("editor") // 'admin' | 'editor'
  created_at DateTime @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  users  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([event_id, user_id])
}

// ---------- Contenido ----------
model gallery_images {
  id         String   @id @default(uuid()) @db.Uuid
  event_id   String   @db.Uuid
  image_url  String
  caption    String?
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
}

model schedule_items {
  id          String    @id @default(uuid()) @db.Uuid
  event_id    String    @db.Uuid
  artist      String
  stage       String?
  starts_at   DateTime  @db.Timestamptz(6)
  ends_at     DateTime? @db.Timestamptz(6)
  description String?
  image_url   String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
}

model food_stalls {
  id         String   @id @default(uuid()) @db.Uuid
  event_id   String   @db.Uuid
  number     Int
  name       String
  owner      String?
  products   String[] @default([])
  image_url  String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([event_id, number])
}

model ads {
  id            String    @id @default(uuid()) @db.Uuid
  event_id      String    @db.Uuid
  business_name String
  image_url     String
  link_url      String?
  description   String?
  is_active     Boolean   @default(true)
  starts_on     DateTime? @db.Date
  ends_on       DateTime? @db.Date
  sort_order    Int       @default(0)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
}

// ---------- Contacto ----------
model contact_messages {
  id         String   @id @default(uuid()) @db.Uuid
  event_id   String   @db.Uuid
  name       String
  email      String
  phone      String?
  type       String // 'artista' | 'gastronomico' | 'comercio' | 'consulta' | 'otro'
  message    String
  status     String   @default("nuevo") // 'nuevo' | 'en_proceso' | 'resuelto'
  created_at DateTime @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
}

// ---------- Bonos de colaboración ----------
model bono_types {
  id          String   @id @default(uuid()) @db.Uuid
  event_id    String   @db.Uuid
  name        String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  event     events           @relation(fields: [event_id], references: [id], onDelete: Cascade)
  purchases bono_purchases[]

  @@index([event_id])
}

model bono_purchases {
  id               String    @id @default(uuid()) @db.Uuid
  event_id         String    @db.Uuid
  bono_type_id     String    @db.Uuid
  code             String    @unique
  buyer_name       String
  buyer_email      String
  buyer_phone      String?
  quantity         Int
  amount           Decimal   @db.Decimal(12, 2)
  status           String    @default("pending") // 'pending' | 'approved' | 'rejected' | 'cancelled' | 'refunded'
  mp_preference_id String?
  mp_payment_id    String?   @unique
  redeemed_at      DateTime? @db.Timestamptz(6)
  redeemed_by      String?   @db.Uuid
  notes            String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)

  event     events    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  bono_type bono_types @relation(fields: [bono_type_id], references: [id])
  redeemer  users?    @relation("redeemed_by", fields: [redeemed_by], references: [id], onDelete: Cascade)

  @@index([event_id, status])
}

// ---------- Rate limit (anti abuso, usado desde el servidor) ----------
model rate_limits {
  key          String   @id
  window_start DateTime @default(now()) @db.Timestamptz(6)
  hits         Int      @default(0)
}
