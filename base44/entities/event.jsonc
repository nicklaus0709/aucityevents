{
  "name": "Event",
  "type": "object",
  "title": "Evento",
  "description": "Un evento/sitio (Navidad, Pascuas, Fiesta Rural...)",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "Dirección web, única (se valida en el panel)"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "tagline": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "history": {
      "type": "string",
      "maxLength": 10000
    },
    "location": {
      "type": "string",
      "maxLength": 200
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "hero_image": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "theme_color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "default": "#b91c1c"
    },
    "accent_color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "default": "#166534"
    },
    "phone": {
      "type": "string",
      "maxLength": 40
    },
    "email": {
      "type": "string",
      "maxLength": 150
    },
    "youtube_url": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
    "facebook_url": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string",
      "pattern": "^[0-9]{8,15}$"
    },
    "bonos_enabled": {
      "type": "boolean",
      "default": false
    },
    "is_published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "slug",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
