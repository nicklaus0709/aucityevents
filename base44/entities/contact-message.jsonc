{
  "name": "ContactMessage",
  "type": "object",
  "title": "Mensaje de contacto",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 150
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "type": {
      "type": "string",
      "enum": [
        "artista",
        "gastronomico",
        "comercio",
        "consulta",
        "otro"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "nuevo",
        "en_proceso",
        "resuelto"
      ],
      "default": "nuevo"
    }
  },
  "required": [
    "event_id",
    "name",
    "email",
    "type",
    "message"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
