# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: solo servidor. Nunca prefijar con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (sin barra final). En Vercel: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (Credenciales de producción de la cuenta del municipio)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Opcional: chatbot con IA (si se omite, responde con reglas simples)
ANTHROPIC_API_KEY=
